  <node id="30" lat="40.0006" lon="-95.9780"/>
  <node id="31" lat="40.0015" lon="-95.9740"/>
  <way id="300">
    <nd ref="1"/><nd ref="2"/>
    <tag k="highway" v="motorway"/>
    <tag k="oneway" v="yes"/>
    <tag k="lanes" v="3"/>
    <tag k="turn:lanes" v="none|none|slight_right"/>
  </way>
  <way id="301">
    <nd ref="2"/><nd ref="3"/>
